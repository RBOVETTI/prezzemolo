# =============================================================================
# CONFIGURAZIONE AMBIENTE - ALL YOU NEED IS THOUGHT
# =============================================================================
# Copia questo file in .env.local e compila con i tuoi dati reali
# NON committare MAI il file .env.local su Git!
# =============================================================================

# -----------------------------------------------------------------------------
# GMAIL SMTP - Per invio email
# -----------------------------------------------------------------------------
# Il tuo indirizzo Gmail completo
GMAIL_USER=tuaemail@gmail.com

# App Password di Gmail (NON la password normale!)
# Come generarla:
# 1. Vai su https://myaccount.google.com/security
# 2. Attiva la verifica in due passaggi
# 3. Vai su "Password per le app" (https://myaccount.google.com/apppasswords)
# 4. Seleziona "App: Mail" e "Dispositivo: Altro (nome personalizzato)"
# 5. Copia la password generata (16 caratteri senza spazi)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# -----------------------------------------------------------------------------
# GOOGLE SHEETS API - Per salvare i lead
# -----------------------------------------------------------------------------
# ID del foglio Google Sheets
# Lo trovi nell'URL: https://docs.google.com/spreadsheets/d/[QUESTO-E-L-ID]/edit
GOOGLE_SHEETS_ID=1abc123def456ghi789jkl012mno345pqr678stu

# Credenziali JSON del Service Account Google
# Come ottenerle:
# 1. Vai su https://console.cloud.google.com/
# 2. Crea un nuovo progetto (o selezionane uno esistente)
# 3. Abilita "Google Sheets API"
# 4. Crea un Service Account:
#    - Vai su "IAM e amministrazione" > "Account di servizio"
#    - Clicca "Crea account di servizio"
#    - Assegna nome e descrizione
#    - Salta i ruoli opzionali
#    - Clicca "Fine"
# 5. Crea una chiave JSON:
#    - Clicca sull'account di servizio appena creato
#    - Vai su "Chiavi" > "Aggiungi chiave" > "Crea nuova chiave"
#    - Seleziona "JSON"
#    - Il file JSON verrà scaricato automaticamente
# 6. Copia TUTTO il contenuto del file JSON qui sotto (in una sola riga, senza spazi o a capo)
# 7. IMPORTANTE: Condividi il foglio Google Sheets con l'email del service account
#    (la trovi nel JSON come "client_email")
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# -----------------------------------------------------------------------------
# SITO WEB - URL pubblico
# -----------------------------------------------------------------------------
# L'URL del tuo sito (senza slash finale)
# In sviluppo locale usa: http://localhost:5173
# In produzione usa: https://tuosito.vercel.app
NEXT_PUBLIC_SITE_URL=https://tuosito.vercel.app

# =============================================================================
# NOTE IMPORTANTI
# =============================================================================
# 1. Questo file .env.example è un TEMPLATE - non contiene dati sensibili
# 2. Copia questo file in .env.local e inserisci i tuoi dati reali
# 3. Il file .env.local è già in .gitignore e NON verrà committato
# 4. Su Vercel, aggiungi queste variabili in: Settings > Environment Variables
# 5. Per il Google Sheets, crea un foglio con le seguenti colonne:
#    A: Timestamp | B: Nome | C: Email | D: Azienda | E: Ruolo | F: Articolo
# 6. Rinomina il foglio in "Leads" (o modifica il codice in api/submit-lead.js)
# =============================================================================

# =============================================================================
# STRUTTURA GOOGLE SHEETS RACCOMANDATA
# =============================================================================
# Crea un nuovo foglio Google Sheets e rinominalo "Leads"
# Aggiungi questi header nella prima riga:
#
# | A: Timestamp | B: Nome | C: Email | D: Azienda | E: Ruolo | F: Articolo |
# |-------------|---------|----------|-----------|---------|-------------|
# |             |         |          |           |         |             |
#
# Poi condividi il foglio con l'email del service account (client_email dal JSON)
# con permessi di "Editor"
# =============================================================================
